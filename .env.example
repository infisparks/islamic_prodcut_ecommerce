# Server Environment
PORT=3000
NODE_ENV=development
PAYMENT_MODE=production
SHIPROCKET_MODE=production
CORS_ORIGIN=*

# Firebase Configuration
FIREBASE_DATABASE_URL=https://your-firebase-app.firebaseio.com
FIREBASE_DATABASE_SECRET=your_firebase_secret
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_api_key

# Shiprocket Credentials
SHIPROCKET_EMAIL=your_shiprocket_email@example.com
SHIPROCKET_PASSWORD=your_shiprocket_password
SHIPROCKET_PICKUP_LOCATION=work
SHIPROCKET_WEBHOOK_SECRET=your_shiprocket_webhook_secret

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_live_YOUR_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# WhatsApp Credentials
WHATSAPP_API_URL=https://evo.infispark.in
WHATSAPP_API_KEY=your_whatsapp_api_key
WHATSAPP_INSTANCE=your_instance

# Meta Pixel & Conversions API Credentials
META_PIXEL_ID=1565922841643245
META_ACCESS_TOKEN=your_meta_conversions_api_access_token
META_TEST_EVENT_CODE=
